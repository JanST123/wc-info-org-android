    <string name="euro_key_dialog_title">Euro key</string>
    <string name="euro_key_dialog_text">The Euro key is a standardized European locking system for accessible toilets. It allows people with disabilities independent access to accessible sanitary facilities.</string>
    <string name="euro_key_info_p1">The Euro key is a locking system introduced in 1986 by CBF Darmstadt (Club of the Disabled and their Friends in Darmstadt and Surroundings) and now used across borders. It allows physically impaired people independent access to accessible sanitary facilities and installations using a uniform key, e.g. at participating highway service areas and train stations, as well as public toilets in pedestrian zones, museums, or authorities.</string>
    <string name="euro_key_info_p2">The key is issued exclusively to people who rely on accessible toilets.</string>
    <string name="euro_key_info_p3">In Germany, a severe disability pass serves as authorization if it includes:\n• category markers: aG, B, H, or BL\n• or category marker G with a degree of disability (GdB) of 70 or higher.</string>
    <string name="euro_key_info_source">Source: %1$s</string>
    <string name="euro_key_info_open_website">Open website (cbf-da.de)</string>
    <string name="euro_key_website_url">https://www.cbf-da.de/leistungen/euroschluessel</string>
